# Optional: offline mode needs no API key. Export these in your shell for llm mode.
# Never commit actual secrets. This application does not auto-load .env files.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional semantic retrieval; local (default) makes no embedding API calls.
RETRIEVAL_EMBEDDINGS=local
# Required only when RETRIEVAL_EMBEDDINGS=remote.
OPENAI_EMBEDDING_MODEL=
